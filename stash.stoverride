name: 'sam_for_stash'
## 放到C:\programData\Stash\override
dns:
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  proxy-server-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  fallback: #!replace
    - 223.5.5.5
    - 119.29.29.29
  fake-ip-filter: #!replace
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.playstation.net'
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
    - '+.n.n.srv.nintendo.net'
    - 'xbox.*.*.microsoft.com'
    - '*.*.xboxlive.com'
    - 'lens.l.google.com'
    - 'time.*.com'
    - 'ntp.*.com'
    - '+.pool.ntp.org'
    - '*.local'
    - '+.lan'
    - 'localhost.ptlogin2.qq.com'
    - '+.iiiyun.sbs'

proxy-providers:
  Subscribe:
    type: http
    url: '订阅链接'
    interval: 86400
    path: ./providers/Subscribe.yaml
    health-check:
      enable: true
      url: 'http://connect.rom.miui.com/generate_204'
      interval: 300

proxy-groups: #!replace
  - name: 手动选择
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png'
    use: [Subscribe]
    filter: '(?i)(专线|中转|Ai应用|Chatgpt|香港|台湾|日本|美国|新加坡|韩国|英国|法国|荷兰|越南|菲律宾|俄罗斯|马来|泰国|印度|德国|加拿大|澳洲|土耳其|阿根廷|巴西|意大利|西班牙)'
  - name: 自动选择
    type: url-test
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Auto.png'
    use: [Subscribe]
    filter: '(?i)(专线|中转|Ai应用|Chatgpt|香港|台湾|日本|美国|新加坡|韩国|英国|法国|荷兰|越南|菲律宾|俄罗斯|马来|泰国|印度|德国|加拿大|澳洲|土耳其|阿根廷|巴西|意大利|西班牙)'
    url: 'http://connect.rom.miui.com/generate_204'
    interval: 300
    tolerance: 50
    lazy: true
  - name: 🤖 AI
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/ChatGPT.png'
    proxies: [自动选择, 手动选择, 🇭🇰 香港, 🇺🇸 美国, 🇸🇬 狮城, 🇯🇵 日本, 🇰🇷 韩国, 🇹🇼 台湾, DIRECT]
  - name: 📺 软媒体
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Streaming.png'
    proxies: [自动选择, 手动选择, 🇭🇰 香港, 🇺🇸 美国, 🇸🇬 狮城, 🇯🇵 日本, 🇰🇷 韩国, 🇹🇼 台湾, DIRECT]
  - name: 🔍 谷歌服务
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Google_Search.png'
    proxies: [自动选择, 手动选择, 🇭🇰 香港, 🇺🇸 美国, 🇸🇬 狮城, 🇯🇵 日本, 🇰🇷 韩国, 🇹🇼 台湾, DIRECT]
  - name: 🏢 微软
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Microsoft.png'
    proxies: [自动选择, 手动选择, 🇭🇰 香港, 🇺🇸 美国, 🇸🇬 狮城, 🇯🇵 日本, 🇰🇷 韩国, 🇹🇼 台湾, DIRECT]
  - name: 🌐 国外网站
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Global.png'
    proxies: [自动选择, 手动选择, 🇭🇰 香港, 🇺🇸 美国, 🇸🇬 狮城, 🇯🇵 日本, 🇰🇷 韩国, 🇹🇼 台湾, DIRECT]
  - name: 🇭🇰 香港
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Hong_Kong.png'
    proxies: [自动选择, 手动选择, DIRECT]
    use: [Subscribe]
    filter: '(?i)(香港|Hong)'
  - name: 🇺🇸 美国
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/United_States.png'
    proxies: [自动选择, 手动选择, DIRECT]
    use: [Subscribe]
    filter: '(?i)(美国)'
  - name: 🇸🇬 狮城
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Singapore.png'
    proxies: [自动选择, 手动选择, DIRECT]
    use: [Subscribe]
    filter: '(?i)(新加坡|狮城)'
  - name: 🇯🇵 日本
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Japan.png'
    proxies: [自动选择, 手动选择, DIRECT]
    use: [Subscribe]
    filter: '(?i)(日本)'
  - name: 🇰🇷 韩国
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Korea.png'
    proxies: [自动选择, 手动选择, DIRECT]
    use: [Subscribe]
    filter: '(?i)(韩国)'
  - name: 🇹🇼 台湾
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/China.png'
    proxies: [自动选择, 手动选择, DIRECT]
    use: [Subscribe]
    filter: '(?i)(台湾)'
  - name: Niu加速
    type: select
    icon: 'https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Airport.png'
    use: [Subscribe]
    filter: '(?i)(专线|中转|Ai应用|Chatgpt|香港|台湾|日本|美国|新加坡|韩国|英国|法国|荷兰|越南|菲律宾|俄罗斯|马来|泰国|印度|德国|加拿大|澳洲|土耳其|阿根廷|巴西|意大利|西班牙)'

rule-providers:
  loyalsoldier-reject:
    behavior: domain
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt'
    interval: 86400
  loyalsoldier-gfw:
    behavior: domain
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt'
    interval: 86400
  lan:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Lan/Lan.yaml'
    interval: 86400
  direct:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Direct/Direct.yaml'
    interval: 86400
  ai:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/OpenAI/OpenAI.yaml'
    interval: 86400
  github:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/GitHub/GitHub.yaml'
    interval: 86400
  microsoft:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Microsoft/Microsoft.yaml'
    interval: 86400
  youtube:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/YouTube/YouTube.yaml'
    interval: 86400
  netflix:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix.yaml'
    interval: 86400
  disney:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Disney/Disney.yaml'
    interval: 86400
  spotify:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Spotify/Spotify.yaml'
    interval: 86400
  google:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Google/Google.yaml'
    interval: 86400
  global:
    behavior: classical
    format: yaml
    url: 'https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Global/Global.yaml'
    interval: 86400

rules:
  - DOMAIN-SUFFIX,iiiyun.sbs,DIRECT
  - RULE-SET,lan,DIRECT,no-resolve
  - RULE-SET,direct,DIRECT
  - RULE-SET,loyalsoldier-reject,REJECT,no-track
  - RULE-SET,ai,🤖 AI
  - RULE-SET,github,🏢 微软
  - RULE-SET,microsoft,🏢 微软
  - RULE-SET,youtube,📺 软媒体
  - RULE-SET,netflix,📺 软媒体
  - RULE-SET,disney,📺 软媒体
  - RULE-SET,spotify,📺 软媒体
  - RULE-SET,google,🔍 谷歌服务
  - RULE-SET,global,🌐 国外网站
  - RULE-SET,loyalsoldier-gfw,🌐 国外网站
